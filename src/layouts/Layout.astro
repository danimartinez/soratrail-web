---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Trail de Sora — Cursa de Muntanya a Sora (Osona)',
  description = 'Trail de Sora: cursa de muntanya de poble, per a tothom, respectuosa amb el medi i amb un fort compromís social. 16 de maig de 2026 — Rutes de 11K i 21K.',
} = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/trail-de-sora/', label: 'Trail de Sora' },
  { href: '/rutes/', label: 'Rutes' },
  { href: '/reglament-2026/', label: 'Reglament' },
  { href: '/albums-de-fotos/', label: 'Fotos' },
  { href: '/patrocinadors/', label: 'Patrocinadors' },
  { href: '/sora-2/', label: 'Sora' },
  { href: '/contact/', label: 'Contacte' },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://soratrail.cat/images/hero-bg.jpg" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-800 antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[#fca52a] focus:text-neutral-900 focus:font-semibold focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg"
    >
      Salta al contingut
    </a>

    <!-- Mobile Navigation Drawer (modern-web-guidance: navigation-drawer) -->
    <div class="Drawer" id="drawer" popover="manual">
      <div class="Drawer-scroller">
        <nav class="Drawer-sheet p-6 flex flex-col justify-between" tabindex="-1" aria-label="Menú mòbil">
          <div>
            <div class="flex items-center justify-between pb-6 border-b border-white/15">
              <a href="/" class="inline-flex items-center gap-2">
                <img
                  src="/images/logo.png"
                  alt="Trail de Sora"
                  width="130"
                  height="58"
                  fetchpriority="low"
                  class="h-12 w-auto object-contain"
                />
              </a>
              <button
                type="button"
                id="drawer-close"
                aria-label="Tanca el menú"
                class="p-2.5 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition"
              >
                <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <ul class="mt-6 space-y-2">
              {navLinks.map((item) => {
                const isActive =
                  item.href === '/'
                    ? currentPath === '/'
                    : currentPath.startsWith(item.href.replace(/\/$/, ''));
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'block px-4 py-3 rounded-lg font-heading text-2xl tracking-wider transition',
                        isActive
                          ? 'bg-[#fca52a] text-neutral-950'
                          : 'text-white hover:bg-white/10 hover:text-[#fca52a]',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>

          <div class="pt-6 border-t border-white/15">
            <a
              href="https://www.instagram.com/traildesora/"
              target="_blank"
              rel="noreferrer noopener"
              class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-lg bg-[#fca52a] text-neutral-950 font-heading text-xl tracking-wider hover:bg-[#e89218] transition"
            >
              <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
              @traildesora
            </a>
          </div>
        </nav>
      </div>
    </div>

    <div id="page-root" class="flex-1 flex flex-col">
      <!-- Top Header -->
      <header class="sticky top-0 z-40 bg-[#181a18]/95 backdrop-blur-md border-b border-white/10 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3 group" aria-label="Trail de Sora - Inici">
            <img
              src="/images/logo.png"
              alt="Trail de Sora"
              width="160"
              height="72"
              class="h-14 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
            />
          </a>

          <!-- Desktop Nav -->
          <nav class="hidden lg:flex items-center gap-1" aria-label="Navegació principal">
            {navLinks.map((item) => {
              const isActive =
                item.href === '/'
                  ? currentPath === '/'
                  : currentPath.startsWith(item.href.replace(/\/$/, ''));
              return (
                <a
                  href={item.href}
                  class:list={[
                    'px-3.5 py-2 rounded-md font-heading text-xl tracking-wider transition-colors',
                    isActive
                      ? 'text-[#fca52a] bg-white/10'
                      : 'text-white/90 hover:text-[#fca52a] hover:bg-white/5',
                  ]}
                >
                  {item.label}
                </a>
              );
            })}

            <a
              href="https://www.instagram.com/traildesora/"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="Instagram Trail de Sora"
              class="ml-3 inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#fca52a] text-neutral-950 hover:bg-[#e89218] transition-transform hover:scale-105"
            >
              <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
          </nav>

          <!-- Mobile Hamburger Trigger -->
          <div class="flex items-center gap-2 lg:hidden">
            <a
              href="https://www.instagram.com/traildesora/"
              target="_blank"
              rel="noreferrer noopener"
              aria-label="Instagram Trail de Sora"
              class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#fca52a] text-neutral-950"
            >
              <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
            <button
              id="drawer-open"
              type="button"
              aria-label="Obre el menú de navegació"
              aria-expanded="false"
              aria-controls="drawer"
              class="inline-flex items-center justify-center p-2.5 rounded-lg text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[#fca52a]"
            >
              <svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Page Content -->
      <main id="content" class="flex-1">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="bg-[#181a18] text-white/80 border-t border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
            <div>
              <a href="/" class="inline-block">
                <img
                  src="/images/logo.png"
                  alt="Trail de Sora"
                  width="150"
                  height="68"
                  loading="lazy"
                  class="h-14 w-auto object-contain"
                />
              </a>
              <p class="mt-4 text-sm text-white/70 max-w-xs leading-relaxed">
                Cursa de muntanya de poble, per a tothom, respectuosa amb el medi i amb un fort compromís social. Perquè SOM DE BOSC!
              </p>
            </div>

            <div>
              <h2 class="font-heading text-2xl text-[#fca52a] tracking-wider mb-3">Seccions</h2>
              <ul class="grid grid-cols-2 gap-2 text-sm">
                {navLinks.map((item) => (
                  <li>
                    <a href={item.href} class="hover:text-[#fca52a] transition-colors">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h2 class="font-heading text-2xl text-[#fca52a] tracking-wider mb-3">Contacte i Ubicació</h2>
              <ul class="space-y-2.5 text-sm">
                <li>
                  <a
                    href="mailto:trailsora@gmail.com"
                    class="inline-flex items-center gap-2 hover:text-[#fca52a] transition-colors"
                  >
                    <svg aria-hidden="true" class="w-4 h-4 text-[#fca52a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    trailsora@gmail.com
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.google.com/maps/dir/42.0466263,2.2335077/trail+de+sora/@42.0261481,2.0549408,11z/data=!3m1!4b1!4m9!4m8!1m1!4e1!1m5!1m1!1s0x12a53d25faf22f2d:0x4d8d88b1099fe2c7!2m2!1d2.1622692!2d42.1125571?entry=ttu"
                    target="_blank"
                    rel="noreferrer noopener"
                    class="inline-flex items-center gap-2 hover:text-[#fca52a] transition-colors"
                  >
                    <svg aria-hidden="true" class="w-4 h-4 text-[#fca52a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Zona esportiva de Sora (Osona)
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.instagram.com/traildesora/"
                    target="_blank"
                    rel="noreferrer noopener"
                    class="inline-flex items-center gap-2 hover:text-[#fca52a] transition-colors"
                  >
                    <svg aria-hidden="true" class="w-4 h-4 text-[#fca52a]" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                    @traildesora
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-white/50 gap-4">
            <p>© {new Date().getFullYear()} Trail de Sora. Tots els drets reservats.</p>
            <p>Fet amb Astro & Cloudflare</p>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const drawer = document.querySelector('#drawer') as HTMLElement | null;
      const scroller = drawer?.querySelector('.Drawer-scroller') as HTMLElement | null;
      const sheet = drawer?.querySelector('.Drawer-sheet') as HTMLElement | null;
      const openBtn = document.querySelector('#drawer-open') as HTMLButtonElement | null;
      const closeBtn = document.querySelector('#drawer-close') as HTMLButtonElement | null;
      const pageRoot = document.querySelector('#page-root') as HTMLElement | null;

      if (drawer && scroller && sheet && openBtn && pageRoot) {
        function openDrawer() {
          drawer!.showPopover();
          pageRoot!.inert = true;
          openBtn!.setAttribute('aria-expanded', 'true');
          scroller!.scrollLeft = 0;
        }

        function closeDrawer() {
          scroller!.scrollLeft = sheet!.offsetWidth;
        }

        openBtn.addEventListener('click', openDrawer);
        closeBtn?.addEventListener('click', closeDrawer);

        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.99) {
              sheet.focus();
            } else if (!entry.isIntersecting) {
              drawer.hidePopover();
              pageRoot.inert = false;
              openBtn.setAttribute('aria-expanded', 'false');
              openBtn.focus();
            }
          },
          { root: scroller, threshold: [0, 0.99] }
        );
        observer.observe(sheet);

        scroller.addEventListener('click', (e) => {
          if (e.target === scroller) closeDrawer();
        });

        addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.matches(':popover-open')) {
            e.preventDefault();
            closeDrawer();
          }
        });

        // Scroll-driven animation fallback for browsers without scroll-timeline support
        if (!CSS.supports('animation-timeline: scroll()')) {
          scroller.addEventListener(
            'scroll',
            () => {
              const progress = 1 - scroller.scrollLeft / sheet.offsetWidth;
              drawer.style.setProperty('--drawer-backdrop', String(Math.max(0, Math.min(1, progress))));
            },
            { passive: true }
          );
        }
      }
    </script>
  </body>
</html>
