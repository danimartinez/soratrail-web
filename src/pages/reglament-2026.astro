---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reglament 2026 — Trail de Sora">
  <section class="bg-[#181a18] text-white py-14 sm:py-20 border-b border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-5xl sm:text-7xl tracking-wider text-[#fca52a]">Reglament 2026</h1>
      <p class="mt-4 text-lg text-white/85">
        Consulta o descarrega el dossier amb el reglament oficial del Trail de Sora 2026.
      </p>
      <div class="mt-6">
        <a
          href="/docs/2026_Dossier_Reglament.pdf"
          download="2026_Dossier_Reglament.pdf"
          class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl bg-[#fca52a] hover:bg-[#e89218] text-neutral-950 font-heading text-2xl tracking-wider shadow-lg transition-colors"
        >
          <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Descarregar 2026_Dossier_Reglament (PDF)
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-[#f6f7f4]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-neutral-200">
        <object
          data="/docs/2026_Dossier_Reglament.pdf"
          type="application/pdf"
          class="w-full h-[750px]"
          aria-label="Dossier Reglament 2026 Trail de Sora"
        >
          <div class="p-10 text-center">
            <p class="text-neutral-700 mb-4">
              El teu navegador no pot previsualitzar el PDF directament.
            </p>
            <a
              href="/docs/2026_Dossier_Reglament.pdf"
              download
              class="inline-block px-6 py-3 rounded-lg bg-[#fca52a] text-neutral-950 font-heading text-xl tracking-wider"
            >
              Descarregar PDF
            </a>
          </div>
        </object>
      </div>
    </div>
  </section>
</Layout>

